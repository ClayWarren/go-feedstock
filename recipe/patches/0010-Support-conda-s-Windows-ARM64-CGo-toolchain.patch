+func TestUseNoCRTResponseFileProbe(t *testing.T) {
+	tests := []struct {
+		name  string
+		goos  string
+		arch  *sys.Arch
+		flags []string
+		flag  string
+		want  bool
+	}{
+		{"windows arm64 conda response file", "windows", sys.ArchARM64, []string{"-nostdlib", "-fuse-ld=lld"}, "@response", true},
+		{"windows amd64", "windows", sys.ArchAMD64, []string{"-nostdlib", "-fuse-ld=lld"}, "@response", false},
+		{"linux arm64", "linux", sys.ArchARM64, []string{"-nostdlib", "-fuse-ld=lld"}, "@response", false},
+		{"standard libraries", "windows", sys.ArchARM64, []string{"-fuse-ld=lld"}, "@response", false},
+		{"nostdlib without lld", "windows", sys.ArchARM64, []string{"-nostdlib"}, "@response", false},
+		{"ordinary flag probe", "windows", sys.ArchARM64, []string{"-nostdlib", "-fuse-ld=lld"}, "-no-pie", false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := useNoCRTResponseFileProbe(test.goos, test.arch, test.flags, test.flag); got != test.want {
+				t.Fatalf("useNoCRTResponseFileProbe() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
