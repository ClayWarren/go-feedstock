 	flags = append(flags, "-o", outPath, flag, trivialPath)
 
@@ -2234,6 +2245,13 @@ func linkerFlagSupported(arch *sys.Arch, linker, altLinker, flag string) bool {
 	return err == nil && !bytes.Contains(out, []byte("unrecognized")) && !bytes.Contains(out, []byte("unknown"))
 }
 
+func useNoCRTResponseFileProbe(goos string, arch *sys.Arch, linkerFlags []string, flag string) bool {
+	return goos == "windows" && arch.Family == sys.ARM64 &&
+		strings.HasPrefix(flag, "@") &&
+		slices.Contains(linkerFlags, "-nostdlib") &&
+		slices.Contains(linkerFlags, "-fuse-ld=lld")
+}
