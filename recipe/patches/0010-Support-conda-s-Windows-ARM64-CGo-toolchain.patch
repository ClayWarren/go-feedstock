+func TestCondaWindowsARM64InternalLinkFlags(t *testing.T) {
+	compilerFlags := []string{
+		"-nostdlib",
+		"-fms-runtime-lib=dll",
+		"-fuse-ld=lld",
+		"-fno-aligned-allocation",
+	}
+	for _, flag := range compilerFlags {
+		if err := checkCompilerFlags("test", "test", []string{flag}); err == nil {
+			t.Errorf("package-source compiler validation unexpectedly accepted %q", flag)
+		}
+	}
+	if err := checkCompilerFlagsForInternalLinkTarget("test", "test", compilerFlags, "windows", "amd64"); err == nil {
+		t.Fatal("non-ARM64 target unexpectedly accepted conda Windows ARM64 compiler flags")
+	}
+	if err := checkCompilerFlagsForInternalLinkTarget("test", "test", compilerFlags, "linux", "arm64"); err == nil {
+		t.Fatal("non-Windows target unexpectedly accepted conda Windows ARM64 compiler flags")
+	}
+	if err := checkCompilerFlagsForInternalLinkTarget("test", "test", compilerFlags, "windows", "arm64"); err != nil {
+		t.Fatalf("internal-link compatibility rejected conda Windows ARM64 compiler flags: %v", err)
+	}
+
+	linkerFlags := []string{
+		"-nostdlib",
+		"-fuse-ld=lld",
+		"-Wl,-defaultlib:C:/conda/clang_rt.builtins-aarch64.lib",
+	}
+	for _, flag := range linkerFlags {
+		if err := checkLinkerFlags("test", "test", []string{flag}); err == nil {
+			t.Errorf("package-source linker validation unexpectedly accepted %q", flag)
+		}
+	}
+	if err := checkLinkerFlagsForInternalLinkTarget("test", "test", linkerFlags, "linux", "arm64"); err == nil {
+		t.Fatal("non-Windows target unexpectedly accepted conda Windows ARM64 linker flags")
+	}
+	if err := checkLinkerFlagsForInternalLinkTarget("test", "test", linkerFlags, "windows", "arm64"); err != nil {
+		t.Fatalf("internal-link compatibility rejected conda Windows ARM64 linker flags: %v", err)
+	}
+
+	for _, flag := range compilerFlags {
+		for _, suffix := range []string{"@args", ",@args", ",-bad"} {
+			smuggled := flag + suffix
+			if err := checkCompilerFlagsForInternalLinkTarget("test", "test", []string{smuggled}, "windows", "arm64"); err == nil {
+				t.Errorf("internal-link compatibility accepted unsafe compiler flag %q", smuggled)
+			}
+		}
+	}
+	for _, flag := range []string{"-fms-runtime-lib=static", "-fuse-ld=link"} {
+		if err := checkCompilerFlagsForInternalLinkTarget("test", "test", []string{flag}, "windows", "arm64"); err == nil {
+			t.Errorf("internal-link compatibility accepted unsafe compiler flag %q", flag)
+		}
+	}
+
+	for _, flag := range linkerFlags {
+		for _, suffix := range []string{"@args", ",@args", ",-bad"} {
+			smuggled := flag + suffix
+			if err := checkLinkerFlagsForInternalLinkTarget("test", "test", []string{smuggled}, "windows", "arm64"); err == nil {
+				t.Errorf("internal-link compatibility accepted unsafe linker flag %q", smuggled)
+			}
+		}
+	}
+	for _, flag := range []string{"-Wl,-defaultlib:", "-Wl,-defaultlib:@args"} {
+		if err := checkLinkerFlagsForInternalLinkTarget("test", "test", []string{flag}, "windows", "arm64"); err == nil {
+			t.Errorf("internal-link compatibility accepted unsafe linker flag %q", flag)
+		}
+	}
+}
+
