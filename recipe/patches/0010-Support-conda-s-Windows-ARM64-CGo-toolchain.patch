From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: conda-forge go-feedstock maintainers <noreply@conda-forge.org>
Date: Thu, 3 Sep 2026 00:00:00 +0000
Subject: [PATCH] Support conda's Windows ARM64 CGo toolchain

Select lld-link for the MSVC-target Clang toolchain and include the
effective linker flags in Go's lld probe. Keep conda's exact native
Windows ARM64 compiler and linker defaults compatible with internal
linking without broadening package-supplied #cgo flag validation. When
-nostdlib and lld are active, test response-file support with an explicit
no-CRT Windows entry point.
---
 src/cmd/go/internal/work/exec.go          |  6 ++
 src/cmd/go/internal/work/security.go      | 38 ++++++++++++-
 src/cmd/go/internal/work/security_test.go | 68 +++++++++++++++++++++++
 src/cmd/link/internal/ld/ld_test.go       | 27 +++++++++
 src/cmd/link/internal/ld/lib.go           | 37 +++++++++---
 5 files changed, 165 insertions(+), 11 deletions(-)

diff --git a/src/cmd/go/internal/work/exec.go b/src/cmd/go/internal/work/exec.go
index 14a7dca8..28fe4904 100644
--- a/src/cmd/go/internal/work/exec.go
+++ b/src/cmd/go/internal/work/exec.go
@@ -2824,6 +2824,7 @@ func (b *Builder) gccArchArgs() []string {
 // using conda based compilers, or return the unmodified default no environment variable is found.
 // On linux, it will disable the linker's gc-sections option.
 // On mac/darwin, it will change/reset the macosx minimal version, and set the isysroot if available.
+// On Windows ARM64, it will select lld-link for CGo.
 func condaGetCompilerFlags(key, def string) string {
 	if value, ok := os.LookupEnv(key); ok {
 		switch cfg.Goos {
@@ -2845,6 +2846,11 @@ func condaGetCompilerFlags(key, def string) string {
 					value = value + " -isysroot " + sysroot
 				}
 			}
+		case "windows":
+			// Go's MSVC-target Clang support requires lld-link.
+			if key == "LDFLAGS" && cfg.Goarch == "arm64" {
+				value += " -fuse-ld=lld"
+			}
 		}
 		return value
 	}
diff --git a/src/cmd/go/internal/work/security.go b/src/cmd/go/internal/work/security.go
index e2c53bbc..f04307b2 100644
--- a/src/cmd/go/internal/work/security.go
+++ b/src/cmd/go/internal/work/security.go
@@ -242,6 +242,22 @@ var validLinkerFlags = []*lazyregexp.Regexp{
 	re(`\./.*\.(a|o|obj|dll|dylib|so|tbd)`),
 }
 
+// These flags are injected by conda's native Windows ARM64 Clang toolchain.
+// They are not valid in package-supplied #cgo directives, but they do not make
+// the host objects incompatible with Go's internal linker.
+var validCondaWindowsARM64CompilerFlagsForInternalLink = []*lazyregexp.Regexp{
+	re(`-nostdlib`),
+	re(`-fms-runtime-lib=dll`),
+	re(`-fuse-ld=lld`),
+	re(`-fno-aligned-allocation`),
+}
+
+var validCondaWindowsARM64LinkerFlagsForInternalLink = []*lazyregexp.Regexp{
+	re(`-nostdlib`),
+	re(`-fuse-ld=lld`),
+	re(`-Wl,-defaultlib:[^,@]+`),
+}
+
 var validLinkerFlagsWithNextArg = []string{
 	"-arch",
 	"-F",
@@ -330,8 +346,17 @@ func checkPkgConfigFlags(name, source string, list []string) error {
 // internal linking (meaning that we should punt the link to the
 // external linker).
 func checkCompilerFlagsForInternalLink(name, source string, list []string) error {
+	return checkCompilerFlagsForInternalLinkTarget(name, source, list, cfg.Goos, cfg.Goarch)
+}
+
+func checkCompilerFlagsForInternalLinkTarget(name, source string, list []string, goos, goarch string) error {
 	checkOverrides := false
-	if err := checkFlags(name, source, list, nil, validCompilerFlags, validCompilerFlagsWithNextArg, checkOverrides); err != nil {
+	valid := validCompilerFlags
+	if goos == "windows" && goarch == "arm64" {
+		valid = append([]*lazyregexp.Regexp{}, validCompilerFlags...)
+		valid = append(valid, validCondaWindowsARM64CompilerFlagsForInternalLink...)
+	}
+	if err := checkFlags(name, source, list, nil, valid, validCompilerFlagsWithNextArg, checkOverrides); err != nil {
 		return err
 	}
 	// Currently the only flag on the allow list that causes problems
@@ -352,8 +377,17 @@ func checkCompilerFlagsForInternalLink(name, source string, list []string) error
 // checkLinkerFlagsForInternalLink returns an error if 'list'
 // contains linker flags that are not compatible with internal linking.
 func checkLinkerFlagsForInternalLink(name, source string, list []string) error {
+	return checkLinkerFlagsForInternalLinkTarget(name, source, list, cfg.Goos, cfg.Goarch)
+}
+
+func checkLinkerFlagsForInternalLinkTarget(name, source string, list []string, goos, goarch string) error {
 	checkOverrides := false
-	if err := checkFlags(name, source, list, nil, validLinkerFlags, validLinkerFlagsWithNextArg, checkOverrides); err != nil {
+	valid := validLinkerFlags
+	if goos == "windows" && goarch == "arm64" {
+		valid = append([]*lazyregexp.Regexp{}, validLinkerFlags...)
+		valid = append(valid, validCondaWindowsARM64LinkerFlagsForInternalLink...)
+	}
+	if err := checkFlags(name, source, list, nil, valid, validLinkerFlagsWithNextArg, checkOverrides); err != nil {
 		return err
 	}
 	// Flags that force static linking require the external linker
