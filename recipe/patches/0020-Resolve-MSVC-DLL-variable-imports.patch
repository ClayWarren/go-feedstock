+// loadDLLImports identifies DLL data through the compiler's address relocations.
+// An MSVC import library defines an import-address slot rather than the data
+// symbol itself. Ordinary globals must continue to use their direct address.
+func (p *Package) loadDLLImports(f *File) {
+	if !f.MSVC || *gccgo || goos != "windows" || (goarch != "arm64" && goarch != "amd64") {
+		return
+	}
+	var names []*Name
+	var b bytes.Buffer
+	b.WriteString(builtinProlog)
+	b.WriteString(f.Preamble)
+	b.WriteByte('\n')
+	for _, key := range nameKeys(f.Name) {
+		n := f.Name[key]
+		if n.Kind != "var" {
+			continue
+		}
+		fmt.Fprintf(&b, "void *__cgo_dllimport_%d(void) { return (void *)&%s; }\n", len(names), n.C)
+		names = append(names, n)
+	}
+	if len(names) == 0 {
+		return
+	}
+	ofile := gccTmp()
+	defer os.Remove(ofile)
+	args := p.gccCmd(ofile)
+	// Give each probe its own section so unrelated preamble references cannot
+	// cause a local global to be mistaken for DLL data.
+	args = append(args[:len(args)-1], "-O0", "-ffunction-sections", "-")
+	runGcc(b.Bytes(), args)
+	obj, err := pe.Open(ofile)
+	if err != nil {
+		fatalf("cannot read DLL variable probe: %v", err)
+	}
+	defer obj.Close()
+	for _, sym := range obj.Symbols {
+		index, ok := strings.CutPrefix(sym.Name, "__cgo_dllimport_")
+		if !ok {
+			continue
+		}
+		i, err := strconv.Atoi(index)
+		if err != nil || i < 0 || i >= len(names) || sym.SectionNumber <= 0 || int(sym.SectionNumber) > len(obj.Sections) {
+			fatalf("invalid DLL variable probe symbol %q", sym.Name)
+		}
+		for _, reloc := range obj.Sections[sym.SectionNumber-1].Relocs {
+			if int(reloc.SymbolTableIndex) >= len(obj.COFFSymbols) {
+				fatalf("invalid DLL variable probe relocation")
+			}
+			target, err := obj.COFFSymbols[reloc.SymbolTableIndex].FullName(obj.StringTable)
+			if err != nil {
+				fatalf("cannot read DLL variable probe relocation: %v", err)
+			}
+			if target == "__imp_"+names[i].C {
+				names[i].DLLImport = target
+			}
+		}
+	}
 }
 
