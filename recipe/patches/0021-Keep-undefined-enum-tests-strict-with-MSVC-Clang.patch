From a4a939095529ac7836809f273f27615fffa7a1e9 Mon Sep 17 00:00:00 2001
From: ClayWarren <warren.clay@icloud.com>
Date: Sat, 5 Sep 2026 16:19:27 -0500
Subject: [PATCH] cmd/cgo: keep strict enum type discovery on Windows ARM64

MSVC-target Clang completes undefined enums as int. CGo suppresses the
warning during type discovery, so a diagnostic pragma cannot enforce these
two negative fixtures. Run their CGo phase with MS extensions disabled,
retaining the configured compiler flags and the original error assertions.
Do not rebuild runtime/cgo or Windows SDK headers with that test-only flag.
Other targets and error fixtures still exercise full Go builds. Production
compiler defaults and flag validation are unchanged.
---
diff --git a/src/cmd/cgo/internal/testerrors/errors_test.go b/src/cmd/cgo/internal/testerrors/errors_test.go
index 6af7c941..cb8c8ae7 100644
--- a/src/cmd/cgo/internal/testerrors/errors_test.go
+++ b/src/cmd/cgo/internal/testerrors/errors_test.go
@@ -6,12 +6,14 @@ package errorstest
 
 import (
 	"bytes"
+	"cmd/internal/quoted"
 	"fmt"
 	"internal/testenv"
 	"os"
 	"os/exec"
 	"path/filepath"
 	"regexp"
+	"runtime"
 	"strconv"
 	"strings"
 	"testing"
@@ -76,6 +78,25 @@ func expect(t *testing.T, errors []*regexp.Regexp, files ...string) {
 	for _, file := range files {
 		args = append(args, path(file))
 	}
+	if runtime.GOOS == "windows" && runtime.GOARCH == "arm64" && len(files) == 1 &&
+		(files[0] == "issue11097a.go" || files[0] == "issue11097b.go") {
+		// MSVC-target Clang treats an undefined enum as a complete int.
+		// These two negative tests require incomplete enums instead. A
+		// diagnostic pragma is insufficient because cgo suppresses warnings
+		// while reading types. Test that phase directly with the extension
+		// disabled, without rebuilding runtime/cgo and the Windows SDK
+		// headers that require MS extensions. Keep the exact error assertions.
+		out, err := testenv.Command(t, testenv.GoToolPath(t), "env", "CGO_CPPFLAGS", "CGO_CFLAGS").Output()
+		if err != nil {
+			t.Fatal(err)
+		}
+		flags, err := quoted.Split(string(out))
+		if err != nil {
+			t.Fatal(err)
+		}
+		args = append([]string{"tool", "cgo", "-objdir", dir, "--"}, flags...)
+		args = append(args, "-fno-ms-extensions", path(files[0]))
+	}
 	cmd := exec.Command(testenv.GoToolPath(t), args...)
 	out, err := cmd.CombinedOutput()
 	if err == nil {
