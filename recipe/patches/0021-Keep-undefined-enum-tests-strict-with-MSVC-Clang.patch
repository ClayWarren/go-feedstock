From ed17483c6f06bbd9df3c59257fd14cba3e22e686 Mon Sep 17 00:00:00 2001
From: ClayWarren <warren.clay@icloud.com>
Date: Sat, 5 Sep 2026 15:57:54 -0500
Subject: [PATCH] cmd/cgo: disable MS enum completion in negative tests

CGo suppresses warnings while discovering types, so diagnostic pragmas do not reject MSVC Clang forward enums. Preserve the original fixtures and their exact-line error assertions; append -fno-ms-extensions only for these two Windows ARM64 test subprocesses, retaining configured CGO_CFLAGS. Do not change production compiler options or flag validation.
---
 src/cmd/cgo/internal/testerrors/errors_test.go | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/cmd/cgo/internal/testerrors/errors_test.go b/src/cmd/cgo/internal/testerrors/errors_test.go
index 6af7c941..f0db71f6 100644
--- a/src/cmd/cgo/internal/testerrors/errors_test.go
+++ b/src/cmd/cgo/internal/testerrors/errors_test.go
@@ -12,6 +12,7 @@ import (
 	"os/exec"
 	"path/filepath"
 	"regexp"
+	"runtime"
 	"strconv"
 	"strings"
 	"testing"
@@ -77,6 +78,19 @@ func expect(t *testing.T, errors []*regexp.Regexp, files ...string) {
 		args = append(args, path(file))
 	}
 	cmd := exec.Command(testenv.GoToolPath(t), args...)
+	if runtime.GOOS == "windows" && runtime.GOARCH == "arm64" && len(files) == 1 &&
+		(files[0] == "issue11097a.go" || files[0] == "issue11097b.go") {
+		// MSVC-target Clang treats an undefined enum as a complete int.
+		// These two negative tests require incomplete enums instead. A
+		// diagnostic pragma is insufficient because cgo suppresses warnings
+		// while reading types. Disable the extension only for these fixtures,
+		// retaining the configured compiler flags and the error assertions.
+		flags, err := testenv.Command(t, testenv.GoToolPath(t), "env", "CGO_CFLAGS").Output()
+		if err != nil {
+			t.Fatal(err)
+		}
+		cmd.Env = append(os.Environ(), "CGO_CFLAGS="+strings.TrimSpace(string(flags))+" -fno-ms-extensions")
+	}
 	out, err := cmd.CombinedOutput()
 	if err == nil {
 		t.Errorf("expected cgo to fail but it succeeded")
-- 
