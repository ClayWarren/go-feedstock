+
+package work
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestRemoveCgoLDFLAGS(t *testing.T) {
+	tests := []struct {
+		name                 string
+		flags, trusted, want []string
+	}{
+		{"windows path", []string{"-nostdlib", `-LC:\\test\\lib`, "-badflag"}, []string{"-nostdlib", `-LC:\test\lib`}, []string{"-badflag"}},
+		{"partial suffix", []string{"-nostdlib"}, []string{"-nostdlib", "-lm"}, []string{"-nostdlib"}},
+		{"injected flag", []string{"-nostdlib", "-badflag", "-lm"}, []string{"-nostdlib", "-lm"}, []string{"-nostdlib", "-badflag", "-lm"}},
+		{"duplicate", []string{"-nostdlib", "-nostdlib"}, []string{"-nostdlib"}, []string{"-nostdlib"}},
+		{"empty", []string{"-badflag"}, nil, []string{"-badflag"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := removeCgoLDFLAGS(slices.Clone(tt.flags), tt.trusted)
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("got %q; want %q", got, tt.want)
+			}
+			if slices.Contains(got, "-badflag") && checkLinkerFlags("LDFLAGS", "test", got) == nil {
+				t.Fatal("unexpectedly accepted injected flag")
+			}
+		})
+	}
+}
