+// removeCgoLDFLAGS removes only the contiguous flags supplied to the cgo action.
+// cgo emits these with %q, and the compiler strips quotes without unescaping.
+// Compare against that same representation, including escaped Windows paths.
+func removeCgoLDFLAGS(flags, trusted []string) []string {
+	if len(trusted) == 0 {
+		return flags
+	}
+	encoded := make([]string, len(trusted))
+	for i, flag := range trusted {
+		encoded[i] = strings.Trim(strconv.Quote(flag), `"`)
+	}
+	for i := 0; i+len(encoded) <= len(flags); i++ {
+		if slices.Equal(flags[i:i+len(encoded)], encoded) {
+			return append(flags[:i], flags[i+len(encoded):]...)
+		}
+	}
+	return flags
+}
