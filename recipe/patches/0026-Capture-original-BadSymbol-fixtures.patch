From: ClayWarren <warren.clay@icloud.com>
Subject: [PATCH] testerrors: retain pristine BadSymbol fixtures for diagnosis

Personal-fork instrumentation only. Preserve the actual compiler command,
original C sources and unmodified outputs before rewrite or TempDir cleanup.
Do not change exports, linking flags, symbol rewriting, or assertions.

diff --git a/src/cmd/cgo/internal/testerrors/badsym_test.go b/src/cmd/cgo/internal/testerrors/badsym_test.go
--- a/src/cmd/cgo/internal/testerrors/badsym_test.go
+++ b/src/cmd/cgo/internal/testerrors/badsym_test.go
@@ -74,6 +74,7 @@ func TestBadSymbol(t *testing.T) {
 	cCompile := func(arg, base, src string) string {
 		out := filepath.Join(cdir, base)
 		run := append(ccCmd, arg, "-o", out, src)
+		t.Logf("BadSymbol fixture compiler: %q", run)
 		output, err := exec.Command(run[0], run[1:]...).CombinedOutput()
 		if err != nil {
 			t.Log(run)
@@ -81,6 +82,22 @@ func TestBadSymbol(t *testing.T) {
 			t.Logf("%s", output)
 			t.Fatal(err)
 		}
+		if capture := os.Getenv("GO_TEST_BADSYMBOL_ARTIFACT_DIR"); capture != "" {
+			if err := os.MkdirAll(capture, 0700); err != nil {
+				t.Fatal(err)
+			}
+			for _, original := range []string{src, out} {
+				data, err := os.ReadFile(original)
+				if err != nil {
+					t.Fatal(err)
+				}
+				destination := filepath.Join(capture, filepath.Base(original))
+				if err := os.WriteFile(destination, data, 0600); err != nil {
+					t.Fatal(err)
+				}
+				t.Logf("Pristine BadSymbol fixture %s: bytes=%d magicCount=%d", destination, len(data), bytes.Count(data, []byte(magicInput)))
+			}
+		}
 		if err := os.Remove(src); err != nil {
 			t.Fatal(err)
 		}
