+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package testenv
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestMSVCCgoExternalLinkTarget(t *testing.T) {
+	for _, test := range []struct {
+		target string
+		want   bool
+	}{
+		{"aarch64-pc-windows-msvc", true},
+		{"aarch64-windows-msvc19.30.0\r\n", true},
+		{"arm64-unknown-windows-msvc", true},
+		{"aarch64-w64-windows-gnu", false},
+		{"aarch64-w64-mingw32", false},
+		{"x86_64-pc-windows-msvc", false},
+		{"aarch64-apple-darwin", false},
+		{"aarch64-unknown-linux-gnu", false},
+		{"aarch64-windows-msvc-invalid", false},
+		{"aarch64-windows-msvcish", false},
+		{"", false},
+	} {
+		if got := msvcCgoNeedsExternalLink(test.target); got != test.want {
+			t.Errorf("target %q: requires external linking = %v, want %v", test.target, got, test.want)
+		}
+	}
+}
+
+func TestCgoCompilerArgs(t *testing.T) {
+	for _, test := range []struct {
+		name, env string
+		want      []string
+	}{
+		{"native", "clang.exe\n\n-O2\n", []string{"clang.exe", "-O2"}},
+		{"quoted paths", "\"C:\\Compiler Tools\\clang.exe\"\r\n-I\"raw\\path\"\r\n'-DVALUE=with space' -O2\r\n", []string{`C:\Compiler Tools\clang.exe`, `-I"raw\path"`, "-DVALUE=with space", "-O2"}},
+		{"compiler wrapper", "ccache clang.exe --target=aarch64-windows-msvc\n-DWIN32\n-O2\n", []string{"ccache", "clang.exe", "--target=aarch64-windows-msvc", "-DWIN32", "-O2"}},
+		{"flag target override", "clang.exe\n\n--target=aarch64-w64-windows-gnu\n", []string{"clang.exe", "--target=aarch64-w64-windows-gnu"}},
+		{"empty compiler", "\n\n-O2\n", nil},
+		{"quoted empty compiler", "\"\"\n\n-O2\n", nil},
+		{"wrong line count", "clang.exe\n-O2\n", nil},
+		{"unclosed quote", "\"clang.exe\n\n-O2\n", nil},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := cgoCompilerArgs(test.env)
+			if test.want == nil {
+				if err == nil {
+					t.Fatal("invalid compiler configuration was accepted")
+				}
+				return
+			}
+			if err != nil || !slices.Equal(got, test.want) {
+				t.Fatalf("compiler arguments = %q, %v; want %q", got, err, test.want)
+			}
+		})
+	}
+}
diff --git a/src/internal/testenv/testenv.go b/src/internal/testenv/testenv.go
index 5aeb5815..c560e079 100644
--- a/src/internal/testenv/testenv.go
+++ b/src/internal/testenv/testenv.go
@@ -353,7 +353,13 @@ func MustHaveCGO(t testing.TB) {
 // CanInternalLink reports whether the current system can link programs with
 // internal linking.
 func CanInternalLink(withCgo bool) bool {
-	return !platform.MustLinkExternal(runtime.GOOS, runtime.GOARCH, withCgo)
+	if platform.MustLinkExternal(runtime.GOOS, runtime.GOARCH, withCgo) {
+		return false
+	}
+	if withCgo && runtime.GOOS == "windows" && runtime.GOARCH == "arm64" {
+		return !msvcCgoNeedsExternalLink(cgoCompilerTarget())
+	}
+	return true
 }
 
 // SpecialBuildTypes are interesting build types that may affect linking.
