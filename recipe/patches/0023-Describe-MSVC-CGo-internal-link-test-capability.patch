+func TestWindowsMSVCInternalLinkModes(t *testing.T) {
+	goTool := mustHaveMSVC(t)
+	if runtime.GOARCH != "arm64" {
+		t.Skip("ARM64 MSVC CGo linker capability")
+	}
+	dir := t.TempDir()
+	src := filepath.Join(dir, "main.go")
+	if err := os.WriteFile(src, []byte("package main\n// int answer(void) { return 42; }\nimport \"C\"\nfunc main() { _ = C.answer() }\n"), 0666); err != nil {
+		t.Fatal(err)
+	}
+	exe := filepath.Join(dir, "main.exe")
+	out, err := testenv.Command(t, goTool, "build", "-ldflags=-linkmode=internal", "-o", exe, src).CombinedOutput()
+	if err == nil || !bytes.Contains(out, []byte("external linking required")) ||
+		(!bytes.Contains(out, []byte("ARM64 COMDAT selection")) && !bytes.Contains(out, []byte("ARM64 exception-handling data"))) {
+		t.Fatalf("expected the documented MSVC CGo limitation: %v\n%s", err, out)
+	}
+	if testenv.CanInternalLink(true) {
+		t.Error("test environment incorrectly enables MSVC ARM64 internal CGo linking")
+	}
+	if !testenv.CanInternalLink(false) {
+		t.Error("test environment incorrectly disables pure Go internal linking")
+	}
+	if err := os.WriteFile(src, []byte("package main\nfunc main() {}\n"), 0666); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := testenv.Command(t, goTool, "build", "-ldflags=-linkmode=internal", "-o", exe, src).CombinedOutput(); err != nil {
+		t.Fatalf("pure Go internal link: %v\n%s", err, out)
+	}
+	if out, err := testenv.Command(t, exe).CombinedOutput(); err != nil || len(out) != 0 {
+		t.Fatalf("pure Go execution: %v\n%s", err, out)
+	}
+}
diff --git a/src/internal/testenv/cgo_link.go b/src/internal/testenv/cgo_link.go
new file mode 100644
index 00000000..e36d474c
--- /dev/null
+++ b/src/internal/testenv/cgo_link.go
@@ -0,0 +1,102 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package testenv
+
+import (
+	"fmt"
+	"os/exec"
+	"strings"
+	"sync"
+)
+
+// MSVC ARM64 CGo objects require associative COMDAT and ARM64 unwind support
+// which the internal PE loader does not implement. Other ARM64 toolchains and
+// pure Go programs keep their existing internal-link tests.
+// Keep the target check and compiler query in sync with cmd/dist/test.go.
+func msvcCgoNeedsExternalLink(target string) bool {
+	parts := strings.Split(strings.TrimSpace(target), "-")
+	if len(parts) < 3 || (parts[0] != "aarch64" && parts[0] != "arm64") || parts[len(parts)-2] != "windows" {
+		return false
+	}
+	abi := parts[len(parts)-1]
+	return abi == "msvc" || len(abi) > 4 && strings.HasPrefix(abi, "msvc") && abi[4] >= '0' && abi[4] <= '9'
+}
+
+var cgoCompilerTarget = sync.OnceValue(func() string {
+	goTool, err := goTool()
+	if err != nil {
+		return ""
+	}
+	cmd := exec.Command(goTool, "env", "CC", "CGO_CPPFLAGS", "CGO_CFLAGS")
+	cmd.Env = origEnv
+	out, err := cmd.Output()
+	if err != nil {
+		return ""
+	}
+	args, err := cgoCompilerArgs(string(out))
+	if err != nil {
+		return ""
+	}
+	cmd = exec.Command(args[0], append(args[1:], "-dumpmachine")...)
+	cmd.Env = origEnv
+	out, err = cmd.Output()
+	if err != nil {
+		// An unknown or broken compiler must not silently disable tests.
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+})
+
+func cgoCompilerArgs(env string) ([]string, error) {
+	lines := strings.Split(strings.TrimSuffix(strings.ReplaceAll(env, "\r\n", "\n"), "\n"), "\n")
+	if len(lines) != 3 {
+		return nil, fmt.Errorf("expected three compiler environment values")
+	}
+	var args []string
+	for i, line := range lines {
+		part, err := cgoQuotedSplit(line)
+		if err != nil {
+			return nil, err
+		}
+		if i == 0 && (len(part) == 0 || part[0] == "") {
+			return nil, fmt.Errorf("empty C compiler command")
+		}
+		args = append(args, part...)
+	}
+	return args, nil
+}
+
+// cgoQuotedSplit follows cmd/internal/quoted.Split. testenv cannot import a
+// cmd/internal package. Quoted fields preserve Windows backslashes verbatim.
+func cgoQuotedSplit(s string) ([]string, error) {
+	space := func(c byte) bool { return c == ' ' || c == '\t' || c == '\n' || c == '\r' }
+	var fields []string
+	for len(s) > 0 {
+		for len(s) > 0 && space(s[0]) {
+			s = s[1:]
+		}
+		if len(s) == 0 {
+			break
+		}
+		if s[0] == '"' || s[0] == '\'' {
+			quote := s[0]
+			s = s[1:]
+			i := strings.IndexByte(s, quote)
+			if i < 0 {
+				return nil, fmt.Errorf("unterminated %c string", quote)
+			}
+			fields = append(fields, s[:i])
+			s = s[i+1:]
+			continue
+		}
+		i := 0
+		for i < len(s) && !space(s[i]) {
+			i++
+		}
+		fields = append(fields, s[:i])
+		s = s[i:]
+	}
+	return fields, nil
+}
