 func (t *tester) internalLink() bool {
+	if t.cgoExternal {
+		return false
+	}
 	if gohostos == "dragonfly" {
 		// linkmode=internal fails on dragonfly since errno is a TLS relocation.
 		return false
@@ -1264,6 +1271,42 @@ func (t *tester) internalLink() bool {
 	return true
 }
 
+// Keep the target check and compiler query in sync with internal/testenv.
+// The bootstrap-built dist command cannot import that package.
+func msvcCgoNeedsExternalLink(target string) bool {
+	parts := strings.Split(strings.TrimSpace(target), "-")
+	if len(parts) < 3 || (parts[0] != "aarch64" && parts[0] != "arm64") || parts[len(parts)-2] != "windows" {
+		return false
+	}
+	abi := parts[len(parts)-1]
+	return abi == "msvc" || len(abi) > 4 && strings.HasPrefix(abi, "msvc") && abi[4] >= '0' && abi[4] <= '9'
+}
+
+func cgoCompilerTarget() string {
+	out, err := exec.Command(gorootBinGo, "env", "CC", "CGO_CPPFLAGS", "CGO_CFLAGS").Output()
+	if err != nil {
+		return ""
+	}
+	lines := strings.Split(strings.TrimSuffix(strings.ReplaceAll(string(out), "\r\n", "\n"), "\n"), "\n")
+	if len(lines) != 3 {
+		return ""
+	}
+	var args []string
+	for i, line := range lines {
+		part, err := quotedSplit(line)
+		if err != nil || i == 0 && (len(part) == 0 || part[0] == "") {
+			return ""
+		}
+		args = append(args, part...)
+	}
+	out, err = exec.Command(args[0], append(args[1:], "-dumpmachine")...).Output()
+	if err != nil {
+		// An unknown or broken compiler must not silently disable tests.
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
