+func TestMSVCCgoLinkRegistration(t *testing.T) {
+	defer func(o, a, ho, ha string) {
+		goos, goarch, gohostos, gohostarch = o, a, ho, ha
+	}(goos, goarch, gohostos, gohostarch)
+	goos, goarch, gohostos, gohostarch = "windows", "arm64", "windows", "arm64"
+	t.Setenv("GO_BUILDER_NAME", "")
+	t.Setenv("GO_TEST_SHARDS", "1")
+	for _, target := range []string{"aarch64-pc-windows-msvc", "aarch64-windows-msvc19.30.0", "aarch64-w64-mingw32", ""} {
+		t.Run(target, func(t *testing.T) {
+			externalOnly := msvcCgoNeedsExternalLink(target)
+			if externalOnly != strings.Contains(target, "-msvc") {
+				t.Fatalf("unexpected compiler classification: %s", target)
+			}
+			dt := tester{
+				cgoEnabled:  true,
+				cgoExternal: externalOnly,
+				short:       true,
+				runNames:    []string{"reflect:pie_internal"},
+			}
+			dt.registerTests()
+			for _, name := range []string{
+				"cmd/cgo/internal/test:internal", "cmd/cgo/internal/test:internal-pie", "os/user:pie_internal",
+			} {
+				if got := dt.testNames[name]; got == externalOnly {
+					t.Errorf("CGo test %s registered = %v; external-only compiler = %v", name, got, externalOnly)
+				}
+			}
+			for _, name := range []string{
+				"cmd/cgo/internal/test:external", "cmd/cgo/internal/test:external-s", "cmd/cgo/internal/test:auto-pie",
+				"reflect:pie_internal", "crypto/internal/fips140test:pie_internal",
+				"crypto/internal/fips140test:exe_external", "crypto/internal/fips140test:pie_external",
+			} {
+				if !dt.testNames[name] {
+					t.Errorf("supported test %s was not registered", name)
+				}
+			}
+		})
+	}
+}
