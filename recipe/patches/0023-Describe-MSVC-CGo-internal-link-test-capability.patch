 src/cmd/dist/test_test.go                |  40 +++++++++
 src/cmd/link/internal/ld/pe_msvc_test.go |  33 ++++++++
 src/internal/testenv/cgo_link.go         | 102 +++++++++++++++++++++++
 src/internal/testenv/cgo_link_test.go    |  62 ++++++++++++++
 src/internal/testenv/testenv.go          |   8 +-
 6 files changed, 287 insertions(+), 1 deletion(-)
 create mode 100644 src/internal/testenv/cgo_link.go
 create mode 100644 src/internal/testenv/cgo_link_test.go

