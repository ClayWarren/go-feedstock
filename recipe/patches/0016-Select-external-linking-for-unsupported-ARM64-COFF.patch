+type linkModeSection struct {
+	name        string
+	size        uint32
+	selection   uint8
+	parent      uint16
+	discardable bool
+	staticData  bool
+}
+
+func TestExternalLinkReason(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		machine  uint16
+		sections []linkModeSection
+		want     string
+	}{
+		{"leaf", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4}}, ""},
+		{"resources", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".rsrc", size: 4}}, ""},
+		{"no duplicates", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_NODUPLICATES}}, ""},
+		{"any", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_ANY}}, ""},
+		{"same size", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_SAME_SIZE}}, ""},
+		{"exact match", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_EXACT_MATCH}}, "COMDAT selection 4"},
+		{"largest", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_LARGEST}}, "COMDAT selection 6"},
+		{"empty associative", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{
+			{name: ".text", size: 4, selection: pe.IMAGE_COMDAT_SELECT_NODUPLICATES},
+			{name: ".xdata", selection: pe.IMAGE_COMDAT_SELECT_ASSOCIATIVE, parent: 1},
+		}, "COMDAT selection 5"},
+		{"packed unwind", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{
+			{name: ".text", size: 4}, {name: ".pdata", size: 8},
+		}, "exception-handling data"},
+		{"full unwind", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{
+			{name: ".text", size: 4}, {name: ".xdata", size: 8}, {name: ".pdata", size: 8},
+		}, "exception-handling data"},
+		{"empty unwind", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".xdata"}, {name: ".pdata"}}, ""},
+		{"ordered unwind", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".pdata$a", size: 8}}, "exception-handling data"},
+		{"discardable unwind", pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{name: ".pdata", size: 8, discardable: true}}, ""},
+		{"amd64 unchanged", pe.IMAGE_FILE_MACHINE_AMD64, []linkModeSection{{name: ".pdata", size: 12}}, ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			data := linkModeObject(t, tt.machine, tt.sections)
+			// Exercise an archive member at a nonzero offset, with another
+			// member following it and bytes already in the buffered reader.
+			prefix := []byte("archive-prefix!!")
+			path := filepath.Join(t.TempDir(), "input.a")
+			if err := os.WriteFile(path, append(append(prefix, data...), []byte("next member")...), 0600); err != nil {
+				t.Fatal(err)
+			}
+			r, err := bio.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer r.Close()
+			r.MustSeek(int64(len(prefix)), 0)
+			if _, err := r.Peek(4); err != nil {
+				t.Fatal(err)
+			}
+			got, err := ExternalLinkReason(r, int64(len(data)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tt.want == "" && got != "" || tt.want != "" && !strings.Contains(got, tt.want) {
+				t.Fatalf("ExternalLinkReason = %q, want %q", got, tt.want)
+			}
+			if off := r.Offset(); off != int64(len(prefix)) {
+				t.Fatalf("reader moved to %d", off)
+			}
+			if got, err := r.Peek(4); err != nil || !bytes.Equal(got, data[:4]) {
+				t.Fatalf("buffer changed: %x, %v", got, err)
+			}
+			if _, err := ExternalLinkReason(r, 19); err == nil {
+				t.Fatal("truncated member header was accepted")
+			}
+		})
+	}
+}
