diff --git a/src/cmd/link/internal/loadpe/linkmode.go b/src/cmd/link/internal/loadpe/linkmode.go
new file mode 100644
--- /dev/null
+++ b/src/cmd/link/internal/loadpe/linkmode.go
@@ -0,0 +1,77 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package loadpe
+
+import (
+	"cmd/internal/bio"
+	"debug/pe"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// ExternalLinkReason reports ARM64 COFF features that require an external
+// linker. It must run before Load, which mutates the symbol and COMDAT state.
+// Reads are bounded to the archive member and do not change input's offset.
+func ExternalLinkReason(input *bio.Reader, length int64) (string, error) {
+	f, err := pe.NewFile(io.NewSectionReader(input.File(), input.Offset(), length))
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	if f.Machine != pe.IMAGE_FILE_MACHINE_ARM64 {
+		return "", nil
+	}
+
+	for i := 0; i < len(f.COFFSymbols); {
+		s := &f.COFFSymbols[i]
+		next := i + 1 + int(s.NumberOfAuxSymbols)
+		if next > len(f.COFFSymbols) {
+			return "", fmt.Errorf("truncated auxiliary symbols at index %d", i)
+		}
+		index := int(s.SectionNumber) - 1
+		if index >= 0 && index < len(f.Sections) &&
+			f.Sections[index].Characteristics&pe.IMAGE_SCN_LNK_COMDAT != 0 &&
+			s.StorageClass == IMAGE_SYM_CLASS_STATIC && s.Type == 0 && s.Value == 0 {
+			name, err := s.FullName(f.StringTable)
+			if err != nil {
+				return "", err
+			}
+			if name != f.Sections[index].Name {
+				// A static data leader can have the same class, type, and
+				// value, but is not the section's definition record.
+				i = next
+				continue
+			}
+			if s.NumberOfAuxSymbols != 1 {
+				return "", fmt.Errorf("invalid section-definition auxiliary count %d", s.NumberOfAuxSymbols)
+			}
+			aux, err := f.COFFSymbolReadSectionDefAux(i)
+			if err != nil {
+				return "", err
+			}
+			switch aux.Selection {
+			case pe.IMAGE_COMDAT_SELECT_NODUPLICATES, pe.IMAGE_COMDAT_SELECT_ANY, pe.IMAGE_COMDAT_SELECT_SAME_SIZE:
+				// Supported by the internal PE loader.
+			default:
+				return fmt.Sprintf("ARM64 COMDAT selection %d", aux.Selection), nil
+			}
+		}
+		i = next
+	}
+	for _, s := range f.Sections {
+		if s.Characteristics&pe.IMAGE_SCN_MEM_DISCARDABLE != 0 || s.Size == 0 {
+			continue
+		}
+		if s.Name == ".pdata" || strings.HasPrefix(s.Name, ".pdata$") ||
+			s.Name == ".xdata" || strings.HasPrefix(s.Name, ".xdata$") {
+			// The internal loader's SEH processing only supports AMD64.
+			// Retaining these as ordinary data would silently lose ARM64
+			// exception/unwind information, even without COMDAT sections.
+			return "ARM64 exception-handling data", nil
+		}
+	}
+	return "", nil
+}
