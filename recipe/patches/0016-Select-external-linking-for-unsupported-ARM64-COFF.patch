+func TestPEObjectLinkMode(t *testing.T) {
+	defer func(goos, goarch string) { buildcfg.GOOS, buildcfg.GOARCH = goos, goarch }(buildcfg.GOOS, buildcfg.GOARCH)
+	buildcfg.GOOS, buildcfg.GOARCH = "windows", "arm64"
+	t.Setenv("GO_EXTLINK_ENABLED", "")
+	forced := os.Getenv("GO_TEST_PE_FORCE_INTERNAL")
+	if forced == "environment" {
+		t.Setenv("GO_EXTLINK_ENABLED", "0")
+	}
+	for _, tt := range []struct {
+		name    string
+		section string
+		short   bool
+		mode    LinkMode
+		want    LinkMode
+		reason  string
+	}{
+		{"unwind", ".pdata", false, LinkAuto, LinkExternal, "exception-handling"},
+		{"resource", ".rsrc", false, LinkAuto, LinkInternal, ""},
+		{"short", ".text", true, LinkAuto, LinkExternal, "unsupported by internal linker"},
+		{"explicit external", ".text", true, LinkExternal, LinkExternal, ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			defer func(h []Hostobj, e, c bool, p string) { hostobj, externalobj, iscgo, unsupportedPEObject = h, e, c, p }(hostobj, externalobj, iscgo, unsupportedPEObject)
+			hostobj, externalobj, iscgo, unsupportedPEObject = nil, false, true, ""
+			var data bytes.Buffer
+			write := func(v any) {
+				if err := binary.Write(&data, binary.LittleEndian, v); err != nil {
+					t.Fatal(err)
+				}
+			}
+			write(pe.FileHeader{Machine: pe.IMAGE_FILE_MACHINE_ARM64, NumberOfSections: 1})
+			var name [8]byte
+			copy(name[:], tt.section)
+			write(pe.SectionHeader32{Name: name, SizeOfRawData: 8, PointerToRawData: 60,
+				Characteristics: pe.IMAGE_SCN_CNT_INITIALIZED_DATA | pe.IMAGE_SCN_MEM_READ})
+			write(uint64(0))
+			// debug/pe reads a 96-byte header even for COFF object files.
+			data.Write(make([]byte, 96-data.Len()))
+			if tt.short {
+				data.Truncate(72)
+			}
+			path := filepath.Join(t.TempDir(), "host.obj")
+			if err := os.WriteFile(path, data.Bytes(), 0600); err != nil {
+				t.Fatal(err)
+			}
+			r, err := bio.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer r.Close()
+			ctxt := &Link{Arch: sys.ArchARM64, HeadType: objabi.Hwindows, BuildMode: BuildModePIE, LinkMode: tt.mode}
+			if forced == "flag" {
+				ctxt.LinkMode = LinkInternal
+			}
+			lib := &sym.Library{Pkg: "runtime/cgo"}
+			h := ldobj(ctxt, r, lib, int64(data.Len()), path, path)
+			if h == nil {
+				t.Fatal("PE input was not registered")
+			}
+			if h.off != 0 || h.length != int64(data.Len()) {
+				t.Fatalf("host object offset/length = %d/%d", h.off, h.length)
+			}
+			if ctxt.loader != nil {
+				t.Fatal("capability scan created loader state")
+			}
+			needed, reason := mustLinkExternal(ctxt)
+			if needed != (tt.reason != "") {
+				t.Fatalf("mustLinkExternal = %v (%s)", needed, reason)
+			}
+			if needed && (!strings.Contains(reason, path) || !strings.Contains(reason, tt.reason)) {
+				t.Fatalf("missing causal diagnostic: %s", reason)
+			}
+			determineLinkMode(ctxt)
+			if ctxt.LinkMode != tt.want {
+				t.Fatalf("link mode = %v, want %v", ctxt.LinkMode, tt.want)
+			}
+		})
+	}
+}
+
+func TestPEObjectLinkModeForcedInternal(t *testing.T) {
+	testenv.MustHaveExec(t)
+	for _, source := range []string{"flag", "environment"} {
+		t.Run(source, func(t *testing.T) {
+			cmd := testenv.Command(t, os.Args[0], "-test.run=^TestPEObjectLinkMode$/^unwind$")
+			cmd.Dir = t.TempDir()
+			cmd.Env = append(os.Environ(), "GO_TEST_PE_FORCE_INTERNAL="+source)
+			out, err := cmd.CombinedOutput()
+			if exit, ok := err.(*exec.ExitError); !ok || exit.ExitCode() != 2 {
+				t.Fatalf("forced internal link = %v, want exit 2; output: %s", err, out)
+			}
+			if !bytes.Contains(out, []byte("external linking required")) ||
+				!bytes.Contains(out, []byte("ARM64 exception-handling data")) {
+				t.Fatalf("missing causal internal-link rejection: %s", out)
+			}
+		})
+	}
+}
