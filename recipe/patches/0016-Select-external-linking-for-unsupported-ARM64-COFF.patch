+func TestExternalLinkReasonStaticData(t *testing.T) {
+	for _, section := range []string{".data", ".bss"} {
+		t.Run(section, func(t *testing.T) {
+			// Clang -fdata-sections emits a section-definition record and
+			// a separate static data leader at offset zero, without aux data.
+			data := linkModeObject(t, pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{
+				name: section, size: 4, selection: pe.IMAGE_COMDAT_SELECT_NODUPLICATES, staticData: true,
+			}})
+			path := filepath.Join(t.TempDir(), "static.obj")
+			if err := os.WriteFile(path, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			r, err := bio.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer r.Close()
+			reason, scanErr := ExternalLinkReason(r, int64(len(data)))
+			// Confirm the fixture is genuinely supported by the internal
+			// loader, not merely accepted by the capability scan.
+			savedImports, savedCOMDATs := importSymsState, comdatDefinitions
+			importSymsState, comdatDefinitions = nil, nil
+			defer func() { importSymsState, comdatDefinitions = savedImports, savedCOMDATs }()
+			l := loader.NewLoader(0, &loader.ErrorReporter{AfterErrorAction: func() { t.Fatal("loader error") }})
+			if _, err := Load(l, sys.ArchARM64, sym.SymVerStatic, r, path, int64(len(data)), path); err != nil {
+				t.Fatalf("invalid regression fixture: %v", err)
+			}
+			if reason != "" || scanErr != nil {
+				t.Fatalf("supported static data requires external linking: %q, %v", reason, scanErr)
+			}
+		})
+	}
+}
+
+func TestExternalLinkReasonSectionDefinition(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		longName bool
+		auxCount byte
+		wantErr  bool
+	}{
+		{"long section name", true, 1, false},
+		{"missing auxiliary record", false, 0, true},
+		{"extra auxiliary record", false, 2, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			data := linkModeObject(t, pe.IMAGE_FILE_MACHINE_ARM64, []linkModeSection{{
+				name: ".data", size: 4, selection: pe.IMAGE_COMDAT_SELECT_EXACT_MATCH, staticData: true,
+			}})
+			symbolOffset := binary.LittleEndian.Uint32(data[8:12])
+			data[symbolOffset+17] = tt.auxCount
+			if tt.longName {
+				// COFF sections use /offset, while symbols use a binary
+				// offset into the string table for names over eight bytes.
+				copy(data[20:28], []byte{'/', '4', 0, 0, 0, 0, 0, 0})
+				copy(data[symbolOffset:symbolOffset+8], []byte{0, 0, 0, 0, 4, 0, 0, 0})
+				tableOffset := len(data) - 4
+				data = append(data, []byte(".data$long_name\x00")...)
+				binary.LittleEndian.PutUint32(data[tableOffset:], uint32(len(data)-tableOffset))
+			}
+			path := filepath.Join(t.TempDir(), "section.obj")
+			if err := os.WriteFile(path, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			r, err := bio.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer r.Close()
+			reason, err := ExternalLinkReason(r, int64(len(data)))
+			if tt.wantErr {
+				if err == nil || !strings.Contains(err.Error(), "auxiliary count") {
+					t.Fatalf("section-definition error = %v", err)
+				}
+			} else if err != nil || !strings.Contains(reason, "COMDAT selection 4") {
+				t.Fatalf("long-name COMDAT classification = %q, %v", reason, err)
+			}
+		})
+	}
+}
+
+func linkModeObject(t *testing.T, machine uint16, sections []linkModeSection) []byte {
+	t.Helper()
+	var data bytes.Buffer
+	write := func(v any) {
+		if err := binary.Write(&data, binary.LittleEndian, v); err != nil {
+			t.Fatal(err)
+		}
+	}
+	start := uint32(20 + 40*len(sections))
+	symbols := start
+	numSymbols := uint32(2 * len(sections))
+	for _, s := range sections {
+		if s.name != ".bss" {
+			symbols += s.size
+		}
+		if s.staticData {
+			numSymbols++
+		}
+	}
+	write(pe.FileHeader{Machine: machine, NumberOfSections: uint16(len(sections)),
+		PointerToSymbolTable: symbols, NumberOfSymbols: numSymbols})
+	for _, s := range sections {
+		var name [8]byte
+		copy(name[:], s.name)
+		flags := uint32(pe.IMAGE_SCN_CNT_INITIALIZED_DATA | pe.IMAGE_SCN_MEM_READ)
+		if s.name == ".text" {
+			flags = pe.IMAGE_SCN_CNT_CODE | pe.IMAGE_SCN_MEM_READ | pe.IMAGE_SCN_MEM_EXECUTE
+		} else if s.name == ".data" {
+			flags |= pe.IMAGE_SCN_MEM_WRITE
+		} else if s.name == ".bss" {
+			flags = pe.IMAGE_SCN_CNT_UNINITIALIZED_DATA | pe.IMAGE_SCN_MEM_READ | pe.IMAGE_SCN_MEM_WRITE
+		}
+		if s.selection != 0 {
+			flags |= pe.IMAGE_SCN_LNK_COMDAT
+		}
+		if s.discardable {
+			flags |= pe.IMAGE_SCN_MEM_DISCARDABLE
+		}
+		rawOffset := uint32(0)
+		if s.name != ".bss" {
+			rawOffset = start
+			start += s.size
+		}
+		write(pe.SectionHeader32{Name: name, SizeOfRawData: s.size, PointerToRawData: rawOffset, Characteristics: flags})
+	}
+	for _, s := range sections {
+		if s.name != ".bss" {
+			data.Write(make([]byte, s.size))
+		}
+	}
+	for i, s := range sections {
+		var name [8]byte
+		copy(name[:], s.name)
+		write(pe.COFFSymbol{Name: name, SectionNumber: int16(i + 1), StorageClass: IMAGE_SYM_CLASS_STATIC, NumberOfAuxSymbols: 1})
+		parent := s.parent
+		if parent == 0 {
+			parent = uint16(i + 1)
+		}
+		write(pe.COFFSymbolAuxFormat5{Size: s.size, SecNum: parent, Selection: s.selection})
+		if s.staticData {
+			write(pe.COFFSymbol{Name: [8]byte{'l', 'o', 'c', 'a', 'l'}, SectionNumber: int16(i + 1), StorageClass: IMAGE_SYM_CLASS_STATIC})
+		}
+	}
+	write(uint32(4))
+	return data.Bytes()
+}
