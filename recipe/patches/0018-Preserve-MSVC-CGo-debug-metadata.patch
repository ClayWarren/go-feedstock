From 309629102c22afa58b50e63409d72d8cfcdcf586 Mon Sep 17 00:00:00 2001
From: ClayWarren <warren.clay@icloud.com>
Date: Sat, 5 Sep 2026 15:19:10 -0500
Subject: [PATCH] cmd/link: preserve debug metadata with MSVC-target lld

Translate Go's normal, -w, and -s modes into lld-link's COFF symbol and DWARF options. Avoid passing ignored GNU strip flags to the MSVC Clang driver. Add flag-selection and native PE/runtime regression tests.
---
 src/cmd/link/internal/ld/lib.go          |  28 +++++-
 src/cmd/link/internal/ld/pe_msvc_test.go | 113 +++++++++++++++++++++++
 2 files changed, 137 insertions(+), 4 deletions(-)
 create mode 100644 src/cmd/link/internal/ld/pe_msvc_test.go

diff --git a/src/cmd/link/internal/ld/lib.go b/src/cmd/link/internal/ld/lib.go
index b2042c30..7804fb1a 100644
--- a/src/cmd/link/internal/ld/lib.go
+++ b/src/cmd/link/internal/ld/lib.go
@@ -1448,7 +1448,15 @@ func (ctxt *Link) hostlink() {
 	argv = append(argv, ctxt.extld()...)
 	argv = append(argv, hostlinkArchArgs(ctxt.Arch)...)
 
-	if *FlagS || debug_s {
+	var isMSVC, isLLD bool // used on Windows
+	if ctxt.IsWindows() {
+		isMSVC = ctxt.isMSVC()
+		isLLD = ctxt.isLLD()
+	}
+
+	if isMSVC && isLLD {
+		argv = append(argv, msvcDebugFlags(*FlagS || debug_s, *FlagW)...)
+	} else if *FlagS || debug_s {
 		if ctxt.HeadType == objabi.Hdarwin {
 			// Recent versions of macOS print
 			//	ld: warning: option -s is obsolete and being ignored
@@ -1466,7 +1474,6 @@ func (ctxt *Link) hostlink() {
 	// Only macOS supports unmapped segments such as our __DWARF segment.
 	combineDwarf := ctxt.IsDarwin() && !*FlagW && machoPlatform == PLATFORM_MACOS
 
-	var isMSVC, isLLD bool // used on Windows
 	wlPrefix := "-Wl,--"
 
 	switch ctxt.HeadType {
@@ -1519,8 +1526,6 @@ func (ctxt *Link) hostlink() {
 			argv = append(argv, "-Wl,--no-execute-only")
 		}
 	case objabi.Hwindows:
-		isMSVC = ctxt.isMSVC()
-		isLLD = ctxt.isLLD()
 		if isMSVC {
 			// For various options, MSVC lld-link only accepts one dash.
 			// TODO: It seems mingw clang supports one or two dashes,
@@ -3210,6 +3215,21 @@ func (ctxt *Link) findExtLinkTool(toolname string) string {
 	return cmdpath
 }
 
+// msvcDebugFlags preserves Go's symbol and DWARF settings with lld-link.
+// Unlike GNU ld, lld-link omits the COFF symbol table and DWARF by default,
+// and MSVC-target Clang does not accept the GNU -s and -Wl,-S options.
+func msvcDebugFlags(stripSymbols, stripDWARF bool) []string {
+	if stripSymbols {
+		return []string{"-Wl,-debug:none"}
+	}
+	if stripDWARF {
+		return []string{"-Wl,-debug:symtab", "-Wl,-debug:nodwarf", "-Wl,-opt:ref"}
+	}
+	// /debug changes lld-link's default to /opt:noref. Preserve the normal
+	// removal of unreferenced COMDATs while retaining symbols and DWARF.
+	return []string{"-Wl,-debug:dwarf", "-Wl,-opt:ref"}
+}
+
 // isMSVC reports whether the C toolchain is clang with a -msvc target,
 // e.g. the clang bundled in MSVC.
 func (ctxt *Link) isMSVC() bool {
diff --git a/src/cmd/link/internal/ld/pe_msvc_test.go b/src/cmd/link/internal/ld/pe_msvc_test.go
new file mode 100644
index 00000000..550b1dfe
--- /dev/null
+++ b/src/cmd/link/internal/ld/pe_msvc_test.go
@@ -0,0 +1,113 @@
