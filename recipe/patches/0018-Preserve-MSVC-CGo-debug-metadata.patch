+package ld
+
+import (
+	"bytes"
+	"cmd/internal/quoted"
+	"debug/pe"
+	"internal/testenv"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestMSVCDebugFlags(t *testing.T) {
+	for _, test := range []struct {
+		name                     string
+		stripSymbols, stripDWARF bool
+		want                     []string
+	}{
+		{"default", false, false, []string{"-Wl,-debug:dwarf", "-Wl,-opt:ref"}},
+		{"symbols only", false, true, []string{"-Wl,-debug:symtab", "-Wl,-debug:nodwarf", "-Wl,-opt:ref"}},
+		{"stripped", true, true, []string{"-Wl,-debug:none"}},
+		{"strip symbols implies no DWARF", true, false, []string{"-Wl,-debug:none"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := msvcDebugFlags(test.stripSymbols, test.stripDWARF); !slices.Equal(got, test.want) {
+				t.Fatalf("msvcDebugFlags() = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestWindowsMSVCExternalDebugInfo(t *testing.T) {
+	if runtime.GOOS != "windows" {
+		t.Skip("Windows PE executable test")
+	}
+	testenv.MustHaveGoBuild(t)
+	testenv.MustHaveCGO(t)
+	goTool := testenv.GoToolPath(t)
+	ccOutput, err := testenv.Command(t, goTool, "env", "CC").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cc, err := quoted.Split(strings.TrimSpace(string(ccOutput)))
+	if err != nil || len(cc) == 0 {
+		t.Fatalf("invalid CC %q: %v", ccOutput, err)
+	}
+	version, err := testenv.Command(t, cc[0], append(cc[1:], "--version")...).CombinedOutput()
+	if err != nil {
+		t.Fatalf("querying CC: %v\n%s", err, version)
+	}
+	if !bytes.Contains(version, []byte("-msvc")) {
+		t.Skip("requires MSVC-target Clang")
+	}
+
+	dir := t.TempDir()
+	src := filepath.Join(dir, "main.go")
+	if err := os.WriteFile(src, []byte(`package main
+// int answer(void) { return 42; }
+import "C"
+func main() { if C.answer() != 42 { panic("incorrect C result") } }
+`), 0666); err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		name, flags    string
+		symbols, dwarf bool
+	}{
+		{"default", "", true, true},
+		{"w", "-w", true, false},
+		{"s", "-s", false, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			exe := filepath.Join(dir, test.name+".exe")
+			out, err := testenv.Command(t, goTool, "build", "-ldflags=-linkmode=external "+test.flags, "-o", exe, src).CombinedOutput()
+			if err != nil || len(out) != 0 {
+				t.Fatalf("external build: %v\n%s", err, out)
+			}
+			f, err := pe.Open(exe)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer f.Close()
+			if got := len(f.Symbols) != 0; got != test.symbols {
+				t.Errorf("COFF symbols present = %v, want %v", got, test.symbols)
+			}
+			if test.symbols {
+				for _, name := range []string{"main.main", "runtime.pclntab", "runtime.types"} {
+					if !slices.ContainsFunc(f.Symbols, func(s *pe.Symbol) bool { return s.Name == name }) {
+						t.Errorf("missing Go symbol %q", name)
+					}
+				}
+			}
+			if got := f.Section(".debug_info") != nil; got != test.dwarf {
+				t.Errorf("DWARF present = %v, want %v", got, test.dwarf)
+			}
+			if test.dwarf {
+				if _, err := f.DWARF(); err != nil {
+					t.Errorf("reading DWARF: %v", err)
+				}
+			}
+			if out, err := testenv.Command(t, exe).CombinedOutput(); err != nil || len(out) != 0 {
+				t.Fatalf("executing CGo program: %v\n%s", err, out)
+			}
+		})
+	}
+}
